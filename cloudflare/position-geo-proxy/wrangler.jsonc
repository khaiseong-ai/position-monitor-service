{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "position-geo-proxy",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "placement": {
    "region": "aws:ap-southeast-1"
  },
  "triggers": {
    "crons": ["2-57/5 * * * *"]
  },
  "observability": {
    "enabled": false
  }
}
